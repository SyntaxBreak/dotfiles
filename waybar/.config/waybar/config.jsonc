{
    "reload_style_on_change": true,
    
    "height": 30,
    "spacing": 4,

    "margin": "13 10 3 10",

    "include": ["~/.config/waybar/modules.jsonc"],

    "modules-left": [
        "clock",
        "hyprland/window",
        "mpris"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "wireplumber",
        "group/batterystats",
        "network"
    ],

    "group/batterystats": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 130
        },
        "modules": [
            "battery",
            "power-profiles-daemon"
        ]     
    }
}